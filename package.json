{
    "name": "ace",
    "description": "Ace (Ajax.org Cloud9 Editor) is a standalone, embeddable JavaScript code editor with syntax highlighting for over 120 languages, themes, and keybindings (Vim, Emacs). It can be used as a textarea replacement in any web page or JavaScript application.",
    "version": "1.2.3",
    "homepage": "http://github.com/ajaxorg/ace",
    "keywords": [
        "editor",
        "code-editor",
        "syntax-highlighting",
        "textarea-replacement",
        "browser",
        "javascript"
    ],
    "engines": {"node": ">= 18.0.0"},
    "author": "Fabian Jakobs <fabian@c9.io>",
    "main": "lib/ace",
    "repository": {
        "type": "git",
         "url": "http://github.com/ajaxorg/ace.git"
    },
    "dependencies": {
        "mime": "1.2.x"
    },
    "devDependencies": {
        "amd-loader": "~0.0.8",
        "architect-build": "0.1.1",
        "asyncjs": "0.0.13",
        "dryice": "0.4.11",
        "eslint": "^8.57.0",
        "jsdom": "^26.1.0"
    },
    "mappings": {
        "ace": "."
    },
    "licenses": [{
        "type": "BSD New",
        "url": "http://opensource.org/licenses/BSD-3-Clause"
    }],
    "directories": {
        "lib": "lib/ace"
    },
    "scripts": {
        "start": "node static.js",
        "test": "node lib/ace/test/all.js",
        "lint": "eslint \"lib/ace/**/*.js\""
    }
}